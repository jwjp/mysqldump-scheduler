; Copy this file to settings.ini.
; Specify an executable name on PATH or an absolute path, without extra arguments.
; Enclose paths containing spaces in double quotes.
mysql-binary = "mysql.exe"
mysqldump-binary = "mysqldump.exe"
; mysql-binary = "C:\Program Files\MySQL\MySQL Server 8.4\bin\mysql.exe"
; mysqldump-binary = "C:\Program Files\MySQL\MySQL Server 8.4\bin\mysqldump.exe"

; By default, only SQL file backups are created.
; Setting this to true drops and recreates the local databases in the restore allowlist.
; A failed restore may leave partially applied changes; there is no automatic rollback.
restore-enabled = false
localhost-host = "127.0.0.1"
localhost-port = 3306
; localhost-username = "backup_restore"
; localhost-password = "replace-with-your-password"
; restore-databases[] = "app"

; Restore requires every source database to appear in the allowlist, with no duplicate names.
; Only loopback restore hosts are allowed; source and target server_uuid values are also checked.
; Tables excluded by ignore-table are also removed when the existing local database is dropped.

retention-days = 30
process-timeout = 3600

; Slack is optional. Notifications are disabled unless a webhook URL is configured.
; Only HTTPS hooks.slack.com/services/... or hooks.slack-gov.com/services/... URLs are allowed.
; slack-url = "https://hooks.slack.com/services/REPLACE/THIS/WEBHOOK"
slack-timeout = 10
; slack-ca-bundle = "C:\Certificates\trusted-ca.pem"
