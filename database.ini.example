; Copy this file to database.ini and update the values.
; Section names: 1-64 ASCII letters/digits/_/-, starting with a letter or digit.
; DB/table names: 1-64 ASCII letters/digits/_/$/-, starting with a letter, digit, or _.
; Use the actual password. Do not apply shell escaping such as replacing ^ with ^^.

[source01]
host = "db-host.internal"
port = 3306
username = "backup_reader"
password = "replace-with-your-password"
database[0] = "app"
; database[1] = "analytics"
; ignore-table[1] = "temporary_report,import_staging"

; Use a separate section for each additional source server.
; Database names must be unique across all sections when local restore is enabled.
; [source02]
; host = "another-db-host.internal"
; port = 3306
; username = "backup_reader"
; password = "replace-with-your-password"
; database[0] = "billing"
